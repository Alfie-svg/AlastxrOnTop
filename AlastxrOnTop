--// AUTO BLOCK
do
	local BLOCK_KEY=Enum.KeyCode.F
	local blockHeld=false
	local lastRelease=0
	local HOLD_TIME=.35

	local function UnderAttack()
		local char=L.Character
		local hum=char and Hum(char)
		if not hum then return false end

		local st=hum:GetState()
		if st==Enum.HumanoidStateType.Ragdoll
			or st==Enum.HumanoidStateType.FallingDown then
			return true
		end

		for _,a in ipairs({"Stunned","HitStun","Attacking","Combat"})do
			if char:GetAttribute(a)==true or hum:GetAttribute(a)==true then
				return true
			end
		end

		local lastHP=_G._AlastxrLastHP
		if lastHP and hum.Health<lastHP then return true end
		return hum.Health<hum.MaxHealth*.99
	end

	local function HoldBlock()
		if blockHeld then return end
		blockHeld=true

		pcall(function()
			VIM:SendKeyEvent(true,BLOCK_KEY,false,game)
		end)

		pcall(function()
			local vu=game:GetService("VirtualUser")
			vu:CaptureController()
			vu:ClickButton2(Vector2.new())
		end)
	end

	local function ReleaseBlock()
		if not blockHeld then return end
		blockHeld=false
		lastRelease=tick()

		pcall(function()
			VIM:SendKeyEvent(false,BLOCK_KEY,false,game)
		end)
	end

	R.Heartbeat:Connect(function()
		local hum=L.Character and Hum(L.Character)

		if hum then
			_G._AlastxrLastHP=hum.Health
		end

		if not S.AutoBlock then
			if blockHeld then ReleaseBlock()end
			return
		end

		if tick()-lastRelease<.15 then return end

		if UnderAttack()then HoldBlock()end

		if blockHeld and tick()-lastRelease>HOLD_TIME then
			ReleaseBlock()
		end
	end)
end

