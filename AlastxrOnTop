local function UpdatePE(p,d)
	if not p.Character then HidePE(d);return end

	local hum,root=Hum(p.Character),Root(p.Character)
	if not hum or not root or hum.Health<=0 then HidePE(d);return end

	local cam=W.CurrentCamera
	if not cam then HidePE(d);return end

	local cf=root.CFrame
	local hw,hh,hd=2.25,3.75,1.25

	local os={
		Vector3.new(hw,hh,hd),Vector3.new(-hw,hh,hd),
		Vector3.new(hw,-hh,hd),Vector3.new(-hw,-hh,hd),
		Vector3.new(hw,hh,-hd),Vector3.new(-hw,hh,-hd),
		Vector3.new(hw,-hh,-hd),Vector3.new(-hw,-hh,-hd)
	}

	local minX,minY=math.huge,math.huge
	local maxX,maxY=-math.huge,-math.huge

	for _,o in ipairs(os)do
		local q=cam:WorldToViewportPoint(cf:PointToWorldSpace(o))

		if q.Z<=1 then
			HidePE(d)
			return
		end

		minX=math.min(minX,q.X)
		minY=math.min(minY,q.Y)
		maxX=math.max(maxX,q.X)
		maxY=math.max(maxY,q.Y)
	end

	local screen=cam.ViewportSize
	local rw,rh=maxX-minX,maxY-minY

	if rw<=2 or rh<=2 or rw>screen.X*.75 or rh>screen.Y*.85 then
		HidePE(d)
		return
	end

	local w=math.clamp(rw*S.PlayerBoxSize,2,500)
	local h=math.clamp(rh*S.PlayerBoxSize,2,700)
	local x,y=(minX+maxX)*.5,(minY+maxY)*.5

	if x~=x or y~=y then HidePE(d);return end

	d.Box.Position=UDim2.fromOffset(x-w/2,y-h/2)
	d.Box.Size=UDim2.fromOffset(w,h)
	d.Box.Visible=S.PlayerBoxes
	d.BoxStroke.Thickness=S.PlayerBoxThickness
	d.BoxStroke.Color=S.PlayerBoxColor

	d.Name.Position=UDim2.fromOffset(x-w/2,y-h/2-S.PlayerNameSize-3)
	d.Name.Size=UDim2.fromOffset(w,S.PlayerNameSize+4)
	d.Name.Text=p.DisplayName..(p.DisplayName~=p.Name and " ["..p.Name.."]"or"")
	d.Name.TextSize=S.PlayerNameSize
	d.Name.Visible=S.PlayerNames

	d.Health.Position=UDim2.fromOffset(x+w/2+5,y-h/2)
	d.Health.Size=UDim2.fromOffset(100,S.PlayerHealthSize+5)
	d.Health.Text=math.floor(math.max(0,hum.Health)).."/"..math.floor(hum.MaxHealth)
	d.Health.TextSize=S.PlayerHealthSize
	d.Health.Visible=S.PlayerHealth

	if S.PlayerTracers then
		local st=Vector2.new(screen.X/2,screen.Y)
		local fn=Vector2.new(x,y+h/2)
		local de=fn-st
		local len=de.Magnitude

		if len>0 and len<screen.Magnitude*2 then
			d.Tracer.Position=UDim2.fromOffset((st.X+fn.X)/2,(st.Y+fn.Y)/2)
			d.Tracer.Size=UDim2.fromOffset(len,S.PlayerTracerThickness)
			d.Tracer.Rotation=math.deg(math.atan2(de.Y,de.X))
			d.Tracer.Visible=true
		else
			d.Tracer.Visible=false
		end
	else
		d.Tracer.Visible=false
	end
end

local function HookPlayer(p)
	if p==L then return end

	MakePE(p)

	p.CharacterAdded:Connect(function()
		task.wait(.15)
		if p.Parent then MakePE(p)end
	end)
end

for _,p in ipairs(P:GetPlayers())do HookPlayer(p)end
P.PlayerAdded:Connect(HookPlayer)
P.PlayerRemoving:Connect(RemovePE)

R.RenderStepped:Connect(function()
	if not PlayerESPEnabled() then
		if PEVisible then
			for _,d in pairs(PE)do HidePE(d)end
			PEVisible=false
		end
		return
	end

	PEVisible=true

	for p,d in pairs(PE)do
		if p.Parent then
			pcall(UpdatePE,p,d)
		else
			RemovePE(p)
		end
	end
end)

--// ITEM ESP
local IEFolder=Instance.new("Folder",ESP)
IEFolder.Name="ItemESP"

local IE={}
local IEVisible=false
local ItemScanNeeded=PlayerESPEnabled()

local function ItemESPEnabled()
	return S.ItemBoxes or S.ItemNames or S.ItemTracers
end

local function HideIE(d)
	if not d then return end

	for _,x in ipairs({"Box","Name","Tracer"})do
		if d[x]then d[x].Visible=false end
	end
end

local function RemoveIE(o)
	local d=IE[o]

	if d then
		for _,v in pairs(d)do
			if typeof(v)=="Instance"and v.Parent then
				v:Destroy()
			end
		end

		IE[o]=nil
	end
end

local function ResolveESPItem(o)
	if not o or IsPlayerPart(o)then return end

	local x=o

	while x and x~=W do
		if(x:IsA("Model")or x:IsA("Tool"))
			and Allowed[x.Name]
			and ItemRoot(x)
			and not IsPlayerPart(x)then
			return x
		end

		x=x.Parent
	end

	if o:IsA("BasePart")and Allowed[o.Name]then return o end
end

local function MakeIE(o)
	o=ResolveESPItem(o)
	if not o or IE[o]then return end

	local root=ItemRoot(o)
	if not root then return end

	local d={}
	IE[o]=d

	local f=Instance.new("Folder",IEFolder)
	f.Name="Item_"..o.Name
	d.Holder=f

	local b=Instance.new("Frame",f)
	b.BackgroundTransparency=1
	b.BorderSizePixel=0
	b.Visible=false
	b.ZIndex=5
	d.Box=b

	local s=Instance.new("UIStroke",b)
	s.Thickness=S.ItemBoxThickness
	s.Color=S.ItemBoxColor
	d.BoxStroke=s

	local n=Instance.new("TextLabel",f)
	n.BackgroundTransparency=1
	n.Visible=false
	n.Font=Enum.Font.GothamBold
	n.TextColor3=Color3.new(1,1,1)
	n.TextStrokeTransparency=0
	n.TextStrokeColor3=Color3.new()
	n.TextSize=S.ItemNameSize
	n.TextXAlignment=Enum.TextXAlignment.Center
	n.ZIndex=6
	d.Name=n

	local t=Instance.new("Frame",f)
	t.BorderSizePixel=0
	t.AnchorPoint=Vector2.new(.5,.5)
	t.BackgroundColor3=Color3.new(1,1,1)
	t.Visible=false
	t.ZIndex=5
	d.Tracer=t
end

local function UpdateIE(o,d)
	if not o or not o.Parent then
		RemoveIE(o)
		return
	end

	if ResolveESPItem(o)~=o then
		HideIE(d)
		return
	end

	local root=ItemRoot(o)
	local cam=W.CurrentCamera

	if not root or not cam then
		HideIE(d)
		return
	end

	local cf,size

	local ok=pcall(function()
		if o:IsA("Model")then
			cf,size=o:GetBoundingBox()
		else
			cf,size=root.CFrame,root.Size
		end
	end)

	if not ok or not cf or not size then
		HideIE(d)
		return
	end

	local h=size*.5

	local os={
		Vector3.new(h.X,h.Y,h.Z),Vector3.new(-h.X,h.Y,h.Z),
		Vector3.new(h.X,-h.Y,h.Z),Vector3.new(-h.X,-h.Y,h.Z),
		Vector3.new(h.X,h.Y,-h.Z),Vector3.new(-h.X,h.Y,-h.Z),
		Vector3.new(h.X,-h.Y,-h.Z),Vector3.new(-h.X,-h.Y,-h.Z)
	}

	local minX,minY=math.huge,math.huge
	local maxX,maxY=-math.huge,-math.huge

	for _,v in ipairs(os)do
		local q=cam:WorldToViewportPoint(cf:PointToWorldSpace(v))

		if q.Z<=.5 then
			HideIE(d)
			return
		end

		minX=math.min(minX,q.X)
		minY=math.min(minY,q.Y)
		maxX=math.max(maxX,q.X)
		maxY=math.max(maxY,q.Y)
	end

	local screen=cam.ViewportSize
	local rw,rh=maxX-minX,maxY-minY

	if rw<=1 or rh<=1 or rw>screen.X*.85 or rh>screen.Y*.85 then
		HideIE(d)
		return
	end

	local w=math.clamp(rw*S.ItemBoxSize,2,screen.X*.85)
	local ht=math.clamp(rh*S.ItemBoxSize,2,screen.Y*.85)
	local x,y=(minX+maxX)*.5,(minY+maxY)*.5

	if x~=x or y~=y then
		HideIE(d)
		return
	end

	d.Box.Position=UDim2.fromOffset(x-w/2,y-ht/2)
	d.Box.Size=UDim2.fromOffset(w,ht)
	d.Box.Visible=S.ItemBoxes
	d.BoxStroke.Thickness=S.ItemBoxThickness
	d.BoxStroke.Color=S.ItemBoxColor

	d.Name.Position=UDim2.fromOffset(x-w/2,y-ht/2-S.ItemNameSize-3)
	d.Name.Size=UDim2.fromOffset(w,S.ItemNameSize+5)
	d.Name.Text=o.Name
	d.Name.TextSize=S.ItemNameSize
	d.Name.Visible=S.ItemNames

	if S.ItemTracers then
		local st=Vector2.new(screen.X/2,screen.Y)
		local fn=Vector2.new(x,y+ht/2)
		local de=fn-st
		local len=de.Magnitude

		if len>0 and len<screen.Magnitude*2 then
			d.Tracer.Position=UDim2.fromOffset((st.X+fn.X)/2,(st.Y+fn.Y)/2)
			d.Tracer.Size=UDim2.fromOffset(len,S.ItemTracerThickness)
			d.Tracer.Rotation=math.deg(math.atan2(de.Y,de.X))
			d.Tracer.Visible=true
		else
			d.Tracer.Visible=false
		end
	else
		d.Tracer.Visible=false
	end
end

-- Only scan Workspace when item ESP is actually enabled.
local function ScanItems()
	if not ItemESPEnabled()then return end

	local found={}

	for _,o in ipairs(W:GetDescendants())do
		local item=ResolveESPItem(o)

		if item then
			found[item]=true
			if not IE[item]then MakeIE(item)end
		end
	end

	for o in pairs(IE)do
		if not found[o]or not o.Parent or not ResolveESPItem(o)then
			RemoveIE(o)
		end
	end
end

local function RefreshItemESP()
	local enabled=ItemESPEnabled()

	if not enabled then
		if IEVisible then
			for _,d in pairs(IE)do HideIE(d)end
			IEVisible=false
		end
		ItemScanNeeded=true
		return
	end

	if ItemScanNeeded then
		ItemScanNeeded=false
		task.defer(ScanItems)
	end
end

-- Initial state
RefreshItemESP()

-- Event-driven item discovery instead of scanning every 2 seconds.
W.DescendantAdded:Connect(function(o)
	if not ItemESPEnabled()then return end

	task.defer(function()
		if not o.Parent or not ItemESPEnabled()then return end

		local item=ResolveESPItem(o)

		if item and not IE[item]then
			MakeIE(item)
		end
	end)
end)

W.DescendantRemoving:Connect(function(o)
	if IE[o]then RemoveIE(o)end
end)

-- Render item ESP only when something is enabled.
R.RenderStepped:Connect(function()
	if not ItemESPEnabled()then
		if IEVisible then
			for _,d in pairs(IE)do HideIE(d)end
			IEVisible=false
		end
		return
	end

	if ItemScanNeeded then
		ItemScanNeeded=false
		task.defer(ScanItems)
	end

	IEVisible=true

	for o,d in pairs(IE)do
		if o and o.Parent then
			pcall(UpdateIE,o,d)
		else
			RemoveIE(o)
		end
	end
end)

--// HITBOX
local HitboxOriginalSize=setmetatable({},{__mode="k"})

local function GetHitboxHRP(p)
	local c=p and p.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function ApplyHitbox(hrp)
	if not hrp then return end

	if not HitboxOriginalSize[hrp]then
		HitboxOriginalSize[hrp]=hrp.Size
	end

	local size=Vector3.new(S.HitboxSize,S.HitboxSize,S.HitboxSize)

	if hrp.Size~=size then
		pcall(function()hrp.Size=size end)
	end
end

local function RestoreHitbox(hrp)
	local old=HitboxOriginalSize[hrp]

	if old then
		pcall(function()
			if hrp.Parent then hrp.Size=old end
		end)

		HitboxOriginalSize[hrp]=nil
	end
end

R.Heartbeat:Connect(function()
	-- Completely idle when hitbox expander is disabled
	-- and there is nothing left to restore.
	if not S.HitboxExpander and next(HitboxOriginalSize)==nil then
		return
	end

	for _,p in ipairs(P:GetPlayers())do
		if p~=L then
			local hrp=GetHitboxHRP(p)

			if hrp then
				if S.HitboxExpander then
					ApplyHitbox(hrp)
				else
					RestoreHitbox(hrp)
				end
			end
		end
	end

	for hrp in pairs(HitboxOriginalSize)do
		if not hrp.Parent then
			HitboxOriginalSize[hrp]=nil
		end
	end
end)

P.PlayerRemoving:Connect(function(p)
	local hrp=GetHitboxHRP(p)
	if hrp then RestoreHitbox(hrp)end
end)

