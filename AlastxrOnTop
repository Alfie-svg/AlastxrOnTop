local PrevFly=false

local function FlightState(active)
	local c=L.Character
	local h=Hum(c)
	local r=Root(c)
	if not h then return end

	if active then
		h.PlatformStand=true
		h.AutoRotate=false
	else
		h.PlatformStand=false
		h.AutoRotate=true
		if r then
			r.AssemblyLinearVelocity=Vector3.zero
			r.AssemblyAngularVelocity=Vector3.zero
		end
	end
end

local function FlightReady()
	if not(S.FlyMaster and S.Fly)then
		if PrevFly then
			FlightState(false)
			PrevFly=false
		end
		return
	end

	local c,h,r,cam=L.Character,Hum(L.Character),Root(L.Character),W.CurrentCamera
	if not c or not h or not r or not cam or h.Health<=0 then return end

	if not PrevFly then
		FlightState(true)
		PrevFly=true
	end

	return c,h,r,cam
end

R:BindToRenderStep("AlastxrFlight",Enum.RenderPriority.Camera.Value+50,function()
	local c,h,r,cam=FlightReady()
	if not c then return end

	local look=cam.CFrame.LookVector

	if not(S.LockOnMaster and S.LockOnEnabled
		and S.LockOnMode=="Character" and Valid(LockTarget))then

		local flat=Vector3.new(look.X,0,look.Z)

		if flat.Magnitude>.001 then
			r.CFrame=CFrame.lookAt(r.Position,r.Position+flat.Unit)
		end
	end

	r.AssemblyAngularVelocity=Vector3.zero
end)

R:BindToRenderStep("AlastxrFlightVelocity",Enum.RenderPriority.Last.Value,function()
	local c,h,r,cam=FlightReady()
	if not c then return end

	local look=cam.CFrame.LookVector
	local right=cam.CFrame.RightVector
	local d=Vector3.zero

	if U:IsKeyDown(Enum.KeyCode.W)then d+=look end
	if U:IsKeyDown(Enum.KeyCode.S)then d-=look end
	if U:IsKeyDown(Enum.KeyCode.D)then d+=right end
	if U:IsKeyDown(Enum.KeyCode.A)then d-=right end

	r.AssemblyLinearVelocity=d.Magnitude>0 and d.Unit*S.FlySpeed or Vector3.zero
	r.AssemblyAngularVelocity=Vector3.zero
end)

L.CharacterAdded:Connect(function()
	PrevFly=false
	StopAutoBlackFlash()
end)

