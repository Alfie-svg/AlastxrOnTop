--// AUTO BLACK FLASH
local AutoBlackFlashRunning=false
local AutoBlackFlashTarget=nil
local AutoBlackFlashFollow=nil

local function StopAutoBlackFlash()
	AutoBlackFlashRunning=false
	AutoBlackFlashTarget=nil
	if AutoBlackFlashFollow then
		pcall(function()AutoBlackFlashFollow:Disconnect()end)
		AutoBlackFlashFollow=nil
	end
end

local function GetBehindPosition(target)
	if not Valid(target)then return end
	local my,tr=Root(L.Character),Root(target.Character)
	if not my or not tr then return end
	local pos=tr.Position-tr.CFrame.LookVector*4
	pos=Vector3.new(pos.X,tr.Position.Y,pos.Z)
	return CFrame.lookAt(pos,tr.Position)
end

local function MouseClick()
	local ok=false
	pcall(function()
		if mouse1click then
			mouse1click()
			ok=true
		end
	end)
	if ok then return true end
	pcall(function()
		VIM:SendMouseButtonEvent(0,0,0,true,game,0)
		VIM:SendMouseButtonEvent(0,0,0,false,game,0)
		ok=true
	end)
	return ok
end

local function BlackFlashInput()
	local ok=false
	pcall(function()
		VIM:SendMouseButtonEvent(0,0,0,true,game,0)
		task.wait(.02)
		VIM:SendMouseButtonEvent(0,0,0,false,game,0)
		ok=true
	end)
	if not ok then
		pcall(function()
			local vu=game:GetService("VirtualUser")
			vu:CaptureController()
			vu:ClickButton1(Vector2.new())
			ok=true
		end)
	end
	return ok
end

local function BlackFlashWindow(c)
	if not c then return false end
	if c:GetAttribute("BlackFlashWindow")==true then return true end
	for _,d in ipairs(c:GetDescendants())do
		if d:IsA("Animator")then
			for _,track in ipairs(d:GetPlayingAnimationTracks())do
				local a=track.Animation
				if a and string.find(string.lower(a.Name or ""),"blackflash",1,true)then
					return true
				end
			end
		end
	end
	return false
end

local BlackFlashLastPulse=0
local BlackFlashDebounce=.9

local function StartAutoBlackFlash(target)
	if not S.AutoBlackFlash or not Valid(target)then return end
	StopAutoBlackFlash()
	AutoBlackFlashRunning=true
	AutoBlackFlashTarget=target

	local root=Root(L.Character)
	if not root then
		StopAutoBlackFlash()
		return
	end

	local targetCF=GetBehindPosition(target)
	if targetCF then
		local start=root.CFrame
		task.spawn(function()
			local elapsed=0
			while AutoBlackFlashRunning
				and AutoBlackFlashTarget==target
				and Valid(target)
				and root.Parent
				and elapsed<.08 do
				task.wait()
				targetCF=GetBehindPosition(target)
				if not targetCF then StopAutoBlackFlash();return end
				elapsed+=.016
				local a=math.clamp(elapsed/.08,0,1)
				a=1-(1-a)^3
				root.CFrame=start:Lerp(targetCF,a)
			end
			if AutoBlackFlashRunning and AutoBlackFlashTarget==target and Valid(target)then
				local cf=GetBehindPosition(target)
				if cf and root.Parent then root.CFrame=cf end
			end
		end)
	end

	AutoBlackFlashFollow=R.RenderStepped:Connect(function()
		if not AutoBlackFlashRunning then return end
		if not Valid(AutoBlackFlashTarget)then StopAutoBlackFlash();return end
		local r=Root(L.Character)
		local cf=GetBehindPosition(AutoBlackFlashTarget)
		if not r or not cf then StopAutoBlackFlash();return end
		if(r.Position-cf.Position).Magnitude>1 then
			r.CFrame=r.CFrame:Lerp(cf,.3)
		end
	end)

	task.spawn(function()
		task.wait(.1)
		if not AutoBlackFlashRunning or AutoBlackFlashTarget~=target
			or not S.AutoBlackFlash or not Valid(target)then return end

		local r=Root(L.Character)
		local cf=GetBehindPosition(target)
		if r and cf then r.CFrame=cf end

		task.wait()

		if not AutoBlackFlashRunning or AutoBlackFlashTarget~=target
			or not S.AutoBlackFlash or not Valid(target)then return end

		MouseClick()
		task.wait(.35)

		if AutoBlackFlashTarget==target then StopAutoBlackFlash()end
	end)
end

