	if not tr then return end

	if S.LockOnMode=="Camera"then
		if cam then
			cam.CFrame=CFrame.lookAt(cam.CFrame.Position,tr.Position)
		end
	else
		local h=Hum(L.Character)
		if h then h.AutoRotate=false end

		if my then
