--// TARGET TRACKING
local Touch={}

local function ClearTouch()
	for _,c in ipairs(Touch)do
		pcall(function()c:Disconnect()end)
	end
	table.clear(Touch)
end

local function Track(c)
	if not c then return end
	ClearTouch()

	local function add(x)
		if x:IsA("BasePart")then
			table.insert(Touch,x.Touched:Connect(function(hit)
				local p=FindPlayer(hit)
				if p and Valid(p)then LastTarget=p end
			end))
		end
	end

	for _,x in ipairs(c:GetDescendants())do add(x)end
	table.insert(Touch,c.DescendantAdded:Connect(add))
end

if L.Character then
	task.defer(function()Track(L.Character)end)
end

L.CharacterAdded:Connect(function(c)
	LastTarget=nil
	task.wait(.1)
	if c.Parent then Track(c)end
end)

local function Closest()
	local cam=W.CurrentCamera
	if not cam then return end

	local center=cam.ViewportSize/2
	local best,bd=nil,math.huge

	for _,p in ipairs(P:GetPlayers())do
		if Valid(p)then
			local q,on=cam:WorldToViewportPoint(Root(p.Character).Position)
			if on then
				local d=(Vector2.new(q.X,q.Y)-center).Magnitude
				if d<bd then
					bd=d
					best=p
				end
			end
		end
	end

	return best
end

