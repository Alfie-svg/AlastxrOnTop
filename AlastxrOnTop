    ur.AlwaysOnTop = true
    local us = Instance.new("TextLabel", ur)
    us.Size = UDim2.fromScale(1, 1)
    us.BackgroundTransparency = 1
    us.Text = un.Name
    us.TextColor3 = Color3.new(1, 1, 1)
    us.TextStrokeTransparency = 0
    us.TextSize = l.ItemNameSize
    us.Font = Enum.Font.GothamBold
    up.Info = ur
  end
  local function ut()
    if not ub() then
      return
    end
    local uu = {}
    for uv, uw in ipairs(e:GetDescendants()) do
      local ux = uc(uw)
      if ux then
        uu[ux] = true
        if not tz[ux] then
          um(ux)
        end
      end
    end
    for uy in pairs(tz) do
      if (not uu[uy] or not uy.Parent) then
        uh(uy)
      end
    end
  end
  local uz = true
  local va = false
  p.RefreshItemESP = function()
    if not ub() then
      for vb, vc in pairs(tz) do
        uf(vc)
      end
      uz = false
      return
    end
    uz = true
  end
  e.DescendantAdded:Connect(function(vd)
    if not ub() then
      return
    end
    task.defer(function()
      if (not vd.Parent or not ub()) then
        return
      end
      local ve = uc(vd)
      if (ve and not tz[ve]) then
        um(ve)
      end
    end)
  end)
  e.DescendantRemoving:Connect(function(vf)
    if tz[vf] then
      uh(vf)
    end
  end)
  c.RenderStepped:Connect(function()
    if not ub() then
      return
    end
    if (uz and not va) then
      va = true
      uz = false
      task.spawn(function()
        ut()
        va = false
      end)
    end
    for vg, vh in pairs(tz) do
      if not vg.Parent then
        uh(vg)
      elseif ub() then
        vh.Box.Enabled = l.ItemBoxes
        vh.Box.OutlineColor = l.ItemBoxColor
        vh.Info.Enabled = l.ItemNames
        local vi = p.ItemRoot(vg)
        if vi then
          vh.Info.Adornee = vi
        end
        local vj = vh.Info:FindFirstChildOfClass("TextLabel")
        if vj then
          vj.TextSize = l.ItemNameSize
        end
      end
    end
  end)
  task.defer(function()
    if ub() then
      uz = true
    end
  end)
end
do
  b.InputBegan:Connect(function(vk, vl)
    if (vk.UserInputType ~= Enum.UserInputType.Keyboard) then
      return
    end
    local vm = vk.KeyCode
    if (p.LockIsListening and p.LockIsListening()) then
      if (vm ~= Enum.KeyCode.Unknown) then
        p.SetLockKey(vm)
      end
      return
    end
    if (p.FlightIsListening and p.FlightIsListening()) then
      if (vm ~= Enum.KeyCode.Unknown) then
        p.SetFlightKey(vm)
      end
      return
    end
    if (p.BlackIsListening and p.BlackIsListening()) then
      if (vm ~= Enum.KeyCode.Unknown) then
        p.SetBlackKey(vm)
      end
      return
    end
    if (p.KillIsListening and p.KillIsListening()) then
      if (vm ~= Enum.KeyCode.Unknown) then
        p.SetKillKey(vm)
      end
      return
    end
    if vl then
      return
    end
    if ((vm == l.FlyKey) and l.FlyMaster) then
      l.Fly = not l.Fly
      if p.RefreshFlight then
        p.RefreshFlight()
      end
    end
    if ((vm == l.LockOnKey) and l.LockOnMaster) then
      if l.LockOnEnabled then
        l.LockOnEnabled = false
        p.LockTarget = nil
      else
        local vn = p.Closest()
        if (vn and p.Valid(vn)) then
          p.LockTarget = vn
          l.LockOnEnabled = true
        end
      end
      if p.RefreshLock then
        p.RefreshLock()
      end
    end
    if ((vm == l.KillKey) and l.KillMaster) then
      if l.KillActive then
        l.KillActive = false
        p.KillTarget = nil
      else
        local vo = p.LastTarget
        if (vo and p.Valid(vo)) then
          p.KillTarget = vo
          l.KillActive = true
        else
          p.KillTarget = nil
          l.KillActive = false
        end
      end
      if p.RefreshKill then
        p.RefreshKill()
      end
    end
    if ((vm == l.AutoBlackFlashKey) and l.AutoBlackFlash) then
      local vp = p.LastTarget
      if (not vp or not p.Valid(vp)) then
        vp = p.Closest()
      end
      if ((vp and p.Valid(vp)) and p.StartAutoBlackFlash) then
        p.StartAutoBlackFlash(vp)
      end
    end
  end)
end
do
  a.PlayerRemoving:Connect(function(vq)
    if (vq == p.LockTarget) then
      p.LockTarget = nil
      l.LockOnEnabled = false
      if p.RefreshLock then
        p.RefreshLock()
      end
    end
    if (vq == p.KillTarget) then
      p.KillTarget = nil
      l.KillActive = false
      if p.RefreshKill then
        p.RefreshKill()
      end
    end
    if (vq == p.LastTarget) then
      p.LastTarget = nil
    end
    if ((vq == p.AutoBlackFlashTarget) and p.StopAutoBlackFlash) then
      p.StopAutoBlackFlash()
    end
  end)
end
