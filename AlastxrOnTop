	Reg(lab,"Text")

	local bar=Instance.new("Frame",h)
	bar.Position=UDim2.new(0,10,0,30)
	bar.Size=UDim2.new(1,-20,0,9)
	bar.BorderSizePixel=0
	bar.ClipsDescendants=true
	bar.BackgroundColor3=Color3.fromRGB(27,27,27)

	local bc=Instance.new("UICorner",bar)
	bc.CornerRadius=UDim.new(1,0)

	local bs=Instance.new("UIStroke",bar)
	bs.Thickness=1
	Reg(bs,"Accent")

	local fill=Instance.new("Frame",bar)
	fill.BorderSizePixel=0
	local fc=Instance.new("UICorner",fill)
	fc.CornerRadius=UDim.new(1,0)

	local knob=Instance.new("Frame",bar)
	knob.AnchorPoint=Vector2.new(.5,.5)
	knob.Size=UDim2.fromOffset(12,12)
	knob.BorderSizePixel=0
	knob.BackgroundColor3=Color3.new(1,1,1)
	knob.ZIndex=3

	local kc=Instance.new("UICorner",knob)
	kc.CornerRadius=UDim.new(1,0)

	local ks=Instance.new("UIStroke",knob)
	ks.Thickness=1
	Reg(ks,"Accent")

	local drag=false

	local function setv(v)
		v=math.clamp(v,min,max)
		local a=(v-min)/(max-min)
		fill.Size=UDim2.new(a,0,1,0)
		knob.Position=UDim2.new(a,0,.5,0)
		lab.Text=t..": "..(math.abs(v-math.floor(v))<.01 and math.floor(v)or string.format("%.1f",v))
		cb(v)
	end

	local function upd(x)
		if bar.AbsoluteSize.X>0 then
			setv(min+(max-min)*math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1))
		end
	end

	bar.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then
			drag=true
			upd(i.Position.X)
		end
	end)

	U.InputChanged:Connect(function(i)
		if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
			upd(i.Position.X)
		end
	end)

	U.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
	end)

	setv(val)
	return h
end

