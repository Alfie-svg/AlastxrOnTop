--// HIGURUMA / DEFENSE ATTORNEY QTE
do
	local QTE_GUI_KEYWORDS={
		"higuruma","trial","qte","judgement","judgment",
		"sentencing","court","finaljudgement","finaljudgment"
	}

	local QTE_BUTTON_KEYS={
		"guilty","innocent","notguilty","yes","no",
		"confirm","answer","w","a","s","d"
	}

	local solvedTimestamps={}

	local function FindQTE(root)
		if not root then return end

		for _,g in ipairs(root:GetDescendants())do
			if g:IsA("ScreenGui")and g.Enabled then
				local n=string.lower(g.Name)

				for _,k in ipairs(QTE_GUI_KEYWORDS)do
					if string.find(n,k,1,true)then return g end
				end
			end
		end
	end

	local function PickButton(gui)
		local candidates={}

		for _,d in ipairs(gui:GetDescendants())do
			if d:IsA("GuiButton")and d.Visible then
				local txt=d:IsA("TextButton")and string.lower(d.Text or "")or""
				local n=string.lower(d.Name)

				for _,k in ipairs(QTE_BUTTON_KEYS)do
					if string.find(n,k,1,true)or string.find(txt,k,1,true)then
						candidates[#candidates+1]=d
						break
					end
				end
			end
		end

		if #candidates>0 then return candidates[1]end

		for _,d in ipairs(gui:GetDescendants())do
			if d:IsA("GuiButton")and d.Visible then return d end
		end
	end

	local function ClickQTEButton(b)
		if not b then return end

		pcall(function()
			b:Activate()
		end)

		pcall(function()
			local pos=b.AbsolutePosition+b.AbsoluteSize/2

			VIM:SendMouseButtonEvent(pos.X,pos.Y,0,true,game,0)
			task.wait(.02)
			VIM:SendMouseButtonEvent(pos.X,pos.Y,0,false,game,0)
		end)
	end

	task.spawn(function()
		while G.Parent do
			task.wait(S.HigurumaQTE and .05 or .5)

			if S.HigurumaQTE then
				local pg=L:FindFirstChild("PlayerGui")
				local gui=FindQTE(pg)

				if gui and(not solvedTimestamps[gui]
					or tick()-solvedTimestamps[gui]>.5)then

					local b=PickButton(gui)

					if b then
						solvedTimestamps[gui]=tick()
						ClickQTEButton(b)
					end
				end
			end
		end
	end)

	pcall(function()
		if hookmetamethod and newcclosure and getnamecallmethod then
			local OldNamecall

			OldNamecall=hookmetamethod(game,"__namecall",newcclosure(function(self,...)
				local method=getnamecallmethod()

				if S.HigurumaQTE
					and method=="FireServer"
					and typeof(self)=="Instance"
					and self:IsA("RemoteEvent")then

					local n=string.lower(self.Name)

					for _,k in ipairs(QTE_GUI_KEYWORDS)do
						if string.find(n,k,1,true)then break end
					end
				end

				return OldNamecall(self,...)
			end))
		end
	end)
end

