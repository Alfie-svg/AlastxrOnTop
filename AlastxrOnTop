--// TARGET HELPERS
local LastTarget,LockTarget,KillTarget
local function Root(c)
	return c and (c:FindFirstChild("HumanoidRootPart")
		or c:FindFirstChild("UpperTorso")
		or c:FindFirstChild("Torso"))
end

local function Hum(c)
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function Valid(p)
	if not p or p==L or not p.Character then return false end
	local h,r=Hum(p.Character),Root(p.Character)
	return h and h.Health>0 and r~=nil
end

local function FindPlayer(part)
	if not part then return end
	for _,p in ipairs(P:GetPlayers())do
		if p~=L and p.Character and part:IsDescendantOf(p.Character)then
			return p
		end
	end
end

