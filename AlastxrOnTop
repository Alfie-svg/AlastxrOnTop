local Allowed={
	["Bowling Ball"]=true,["Naginata"]=true,["Banana Peel"]=true,["TNT"]=true,
	["Tinted Glasses"]=true,["Transfigured Human"]=true,["Sniper"]=true,
	["Hazenoki's Eye"]=true,["Voice Recorder"]=true,["Transfigured Flesh"]=true,
	["Playful Cloud"]=true,["Gun"]=true,["Jet Black"]=true,["Coin"]=true,["Soda"]=true
}

local ItemNames={
	"Bowling Ball","Naginata","Banana Peel","TNT","Tinted Glasses",
	"Transfigured Human","Sniper","Hazenoki's Eye","Voice Recorder",
	"Transfigured Flesh","Playful Cloud","Gun","Jet Black","Coin","Soda"
}

local CharacterSet={}

local function IsPlayerPart(o)
	if not o then return true end
	for c in pairs(CharacterSet)do
		if c and c.Parent and o:IsDescendantOf(c)then return true end
	end
	return false
end

local function ItemRoot(o)
	if not o then return end
	if o:IsA("BasePart")then return o end
	if o:IsA("Tool")then
		return o:FindFirstChild("Handle")or o:FindFirstChildWhichIsA("BasePart",true)
	end
	if o:IsA("Model")then
		return o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart",true)
	end
end

local function ItemContainer(o)
	if not o or IsPlayerPart(o)then return end

	if(o:IsA("Model")or o:IsA("Tool"))
		and Allowed[o.Name] and ItemRoot(o)then
		return o
	end

	local x=o
	while x and x~=W do
		if(x:IsA("Model")or x:IsA("Tool"))
			and Allowed[x.Name] and ItemRoot(x) and not IsPlayerPart(x)then
			return x
		end
		x=x.Parent
	end

	if o:IsA("BasePart")and Allowed[o.Name]then return o end
end

local function GetItems(name)
	local found,seen={},{}
	for _,o in ipairs(W:GetDescendants())do
		local x=ItemContainer(o)
		if x and(not name or x.Name==name)and not seen[x]then
			seen[x]=true
			found[#found+1]=x
		end
	end
	return found
end

local function MoveItem(o,pos)
	o=ItemContainer(o)or o
	if not o or not o.Parent or IsPlayerPart(o)then return false end
	local r=ItemRoot(o)
	if not r then return false end

	return pcall(function()
		if o:IsA("Model")then
			o:PivotTo(CFrame.new(pos))
		else
			r.CFrame=CFrame.new(pos)
		end
	end)
end

local function BringOne(name)
	local r=Root(L.Character)
	if not r then return end

	local best,bd=nil,math.huge
	for _,o in ipairs(GetItems(name))do
		local x=ItemRoot(o)
		if x then
			local d=(x.Position-r.Position).Magnitude
			if d<bd then
				bd=d
				best=o
			end
		end
	end

	if best then
		MoveItem(best,r.Position+r.CFrame.LookVector*3+Vector3.new(0,1,0))
	end
end

local function BringAll()
	local r=Root(L.Character)
	if not r then return end

	for i,o in ipairs(GetItems())do
		local n=i-1
		local ang=(n%12)/12*math.pi*2
		local rad=3+math.floor(n/12)*2

		MoveItem(
			o,
			r.Position+Vector3.new(
				math.cos(ang)*rad,
				1+math.floor(n/36)*2,
				math.sin(ang)*rad
			)
		)
	end
end

