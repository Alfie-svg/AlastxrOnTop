local function Theme()
	CT=Themes[S.Theme]or Themes.Default
	for o,r in pairs(TO)do
		if o.Parent then
			if o:IsA("TextLabel")or o:IsA("TextButton")then
				o.TextColor3=Color3.new(1,1,1)
			elseif o:IsA("UIStroke")and CT[r]then
