--// HITBOX
local HitboxOriginalSizes=setmetatable({},{__mode="k"})

local function GetHitParts(p)
	local c=p and p.Character
	if not c then return {} end

	local parts={}

	for _,n in ipairs({
		"HumanoidRootPart",
		"Head",
		"UpperTorso",
		"LowerTorso",
		"Torso",
		"LeftUpperArm",
		"LeftLowerArm",
		"LeftHand",
		"RightUpperArm",
		"RightLowerArm",
		"RightHand",
		"LeftUpperLeg",
		"LeftLowerLeg",
		"LeftFoot",
		"RightUpperLeg",
		"RightLowerLeg",
		"RightFoot"
	})do
		local x=c:FindFirstChild(n)
		if x and x:IsA("BasePart")then
			parts[#parts+1]=x
		end
	end

	return parts
end

local function ApplyHitboxPart(part)
	if not part or not part.Parent then return end

	if not HitboxOriginalSizes[part]then
		HitboxOriginalSizes[part]={
			Size=part.Size,
			Transparency=part.Transparency,
			CanCollide=part.CanCollide,
			CanTouch=part.CanTouch,
			Massless=part.Massless
		}
	end

	local s=S.HitboxSize

	pcall(function()
		if part.Name=="HumanoidRootPart"then
			part.Size=Vector3.new(s,s,s)
		elseif part.Name=="Head"then
			local v=math.max(1,s*.55)
			part.Size=Vector3.new(v,v,v)
		else
			local old=HitboxOriginalSizes[part].Size
			part.Size=Vector3.new(
				math.max(old.X,s*.35),
				math.max(old.Y,s*.35),
				math.max(old.Z,s*.35)
			)
		end

		part.CanTouch=true
		part.Massless=true
	end)
end

local function RestoreHitboxPart(part)
	local old=HitboxOriginalSizes[part]
	if not old then return end

	pcall(function()
		if part.Parent then
			part.Size=old.Size
			part.Transparency=old.Transparency
			part.CanCollide=old.CanCollide
			part.CanTouch=old.CanTouch
			part.Massless=old.Massless
		end
	end)

	HitboxOriginalSizes[part]=nil
end

R.Heartbeat:Connect(function()
	if not S.HitboxExpander and not next(HitboxOriginalSizes)then
		return
	end

	for _,p in ipairs(P:GetPlayers())do
		if p~=L then
			if S.HitboxExpander then
				for _,part in ipairs(GetHitParts(p))do
					ApplyHitboxPart(part)
				end
			else
				for part in pairs(HitboxOriginalSizes)do
					RestoreHitboxPart(part)
				end
			end
		end
	end

	for part in pairs(HitboxOriginalSizes)do
		if not part.Parent then
			HitboxOriginalSizes[part]=nil
		end
	end
end)

P.PlayerRemoving:Connect(function(p)
	for part in pairs(HitboxOriginalSizes)do
		if p.Character and part:IsDescendantOf(p.Character)then
			RestoreHitboxPart(part)
		end
	end
end)

