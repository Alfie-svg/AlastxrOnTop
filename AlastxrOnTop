local RL=RH("ResizeLeft",UDim2.fromOffset(0,10),UDim2.new(0,12,1,-20))

local rm,rsz,rpos,resizeMouseX,resizeMouseY

local function BeginResize(mode)
	if S.MenuCondensed then return end
	rm=mode
	rsz=M.AbsoluteSize
	rpos=M.AbsolutePosition
	local q=U:GetMouseLocation()
	resizeMouseX=q.X
	resizeMouseY=q.Y
end

RR.MouseButton1Down:Connect(function()BeginResize("Right")end)
RB.MouseButton1Down:Connect(function()BeginResize("Bottom")end)
RBR.MouseButton1Down:Connect(function()BeginResize("BottomRight")end)
RBL.MouseButton1Down:Connect(function()BeginResize("BottomLeft")end)
RL.MouseButton1Down:Connect(function()BeginResize("Left")end)

U.InputChanged:Connect(function(i)
	if not rm or i.UserInputType~=Enum.UserInputType.MouseMovement then return end

	local cur=i.Position
	local dx=cur.X-resizeMouseX
	local dy=cur.Y-resizeMouseY
	local nw,nh=rsz.X,rsz.Y
	local nx,ny=rpos.X,rpos.Y

	if rm=="Right" then
		nw=rsz.X+dx
	elseif rm=="Bottom" then
		nh=rsz.Y+dy
	elseif rm=="BottomRight" then
		nw=rsz.X+dx
		nh=rsz.Y+dy
	elseif rm=="Left" then
		nw=rsz.X-dx
		nx=rpos.X+dx
	elseif rm=="BottomLeft" then
		nw=rsz.X-dx
		nh=rsz.Y+dy
		nx=rpos.X+dx
	end

	nw=math.max(MinW,nw)
	nh=math.max(MinH,nh)

	local cam=W.CurrentCamera
	if cam then
		local v=cam.ViewportSize
		nw=math.min(nw,v.X)
		nh=math.min(nh,v.Y)
		nx=math.clamp(nx,0,math.max(0,v.X-nw))
		ny=math.clamp(ny,0,math.max(0,v.Y-nh))
	end

	M.Position=UDim2.fromOffset(nx,ny)
	M.Size=UDim2.fromOffset(nw,nh)
end)

