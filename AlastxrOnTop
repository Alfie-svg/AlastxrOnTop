		for _,p in ipairs(AttackersNow())do
			local h=Hum(p.Character)
			local anim=h and h:FindFirstChildOfClass("Animator")

			if anim then
				for _,track in ipairs(anim:GetPlayingAnimationTracks())do
					local a=track.Animation

					if a then
						local n=string.lower(a.Name or "")

						if string.find(n,"punch",1,true)
							or string.find(n,"attack",1,true)
							or string.find(n,"m1",1,true)then
							return p
						end
					end
				end
			end
		end
