do
	local COUNTER_WINDOW=.12
	local COUNTER_COOLDOWN=.55
	local lastCounter={}

	local function AttackersNow()
		local result={}
		local myRoot=Root(L.Character)
		if not myRoot then return result end

		for _,p in ipairs(P:GetPlayers())do
			if p~=L and p.Character then
				local h=Hum(p.Character)
				local r=Root(p.Character)

				if h and r and h.Health>0
					and(r.Position-myRoot.Position).Magnitude<=12 then
					result[#result+1]=p
				end
			end
		end

