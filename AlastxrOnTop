local FW,FH=720,520
local MinW,MinH=560,380
local FullSize=UDim2.fromOffset(FW,FH)
local MiniSize=UDim2.fromOffset(FW,52)

local function Clamp()
	local cam=W.CurrentCamera
	if not cam then return end

	local v=cam.ViewportSize
	local w,h=M.AbsoluteSize.X,M.AbsoluteSize.Y
	local x,y=M.AbsolutePosition.X,M.AbsolutePosition.Y

	M.Position=UDim2.fromOffset(
		math.clamp(x,0,math.max(0,v.X-w)),
		math.clamp(y,0,math.max(0,v.Y-h))
	)
end

Min.MouseButton1Click:Connect(function()
	if S.MenuCondensed then
		S.MenuCondensed=false
		Body.Visible=true
		tw(M,{Size=FullSize})
	else
		S.MenuCondensed=true
		Body.Visible=true
		local x=tw(M,{Size=MiniSize})

		if x then
			x.Completed:Connect(function()
				if S.MenuCondensed and M.Parent then Body.Visible=false end
			end)
		else
			Body.Visible=false
		end
	end
end)

