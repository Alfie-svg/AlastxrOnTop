--// CHARACTER HELPERS
function X.Root(c)
    if not c then
        return
    end

    return c:FindFirstChild("HumanoidRootPart")
        or c:FindFirstChild("UpperTorso")
        or c:FindFirstChild("Torso")
end

function X.Hum(c)
    if not c then
        return
    end

    return c:FindFirstChildOfClass("Humanoid")
end

function X.Valid(p)
    if not p
        or p==L
        or p.Parent~=P
    then
        return false
    end

    local c=p.Character
    local h=X.Hum(c)
    local r=X.Root(c)

    return c
        and h
        and r
        and h.Health>0
end

function X.FindPlayer(part)
    if not part then
        return
    end

    for _,p in ipairs(P:GetPlayers()) do
        if p~=L
            and p.Character
            and part:IsDescendantOf(p.Character)
        then
            return p
        end
    end
end

