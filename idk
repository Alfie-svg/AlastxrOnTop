--// HITBOX EXPANDER
do
    local Original=setmetatable(
        {},
        {__mode="k"}
    )

    local function Apply(part)
        if not part
            or not part.Parent
        then
            return
        end

        if not Original[part] then
            Original[part]=part.Size
        end

        local amount=math.clamp(
            S.HitboxSize,
            1,
            12
        )

        local newSize=Vector3.new(
            amount,
            amount,
            amount
        )

        pcall(function()
            part.Size=newSize
            part.CanTouch=true
            part.CanQuery=true
        end)
    end

    local function Restore(part)
        local old=Original[part]

        if not old then
            return
        end

        pcall(function()
            if part.Parent then
                part.Size=old
            end
        end)

        Original[part]=nil
    end

    R.Heartbeat:Connect(function()
        if not S.HitboxExpander then
            if next(Original)==nil then
                return
            end

            for part in pairs(Original) do
                if part.Parent then
                    Restore(part)
                else
                    Original[part]=nil
                end
            end

            return
        end

        for _,p in ipairs(P:GetPlayers()) do
            if p~=L then
                local c=p.Character
                local h=c and X.Hum(c)

                if h and h.Health>0 then
                    local hrp=c:FindFirstChild(
                        "HumanoidRootPart"
                    )

                    if hrp then
                        Apply(hrp)
                    end
                end
            end
        end

        for part in pairs(Original) do
            if not part.Parent then
                Original[part]=nil
            end
        end
    end)

    P.PlayerRemoving:Connect(function(p)
        local c=p.Character

        if not c then
            return
        end

        local hrp=c:FindFirstChild(
            "HumanoidRootPart"
        )

        if hrp then
            Restore(hrp)
        end
    end)
end

--// AUTO BLOCK
do
    local blockHeld=false
    local lastRelease=0
    local BLOCK_KEY=Enum.KeyCode.F

    local function UnderAttack()
        local c=L.Character
        local h=X.Hum(c)

        if not h then
            return false
        end

        local state=h:GetState()

        if state==Enum.HumanoidStateType.Ragdoll
            or state==Enum.HumanoidStateType.FallingDown
        then
            return true
        end

        for _,name in ipairs({
            "Stunned",
            "HitStun",
            "Attacking",
            "Combat"
        }) do
            if c:GetAttribute(name)==true
                or h:GetAttribute(name)==true
            then
                return true
            end
        end

        local lastHP=_G._AlastxrLastHP

        if lastHP
            and h.Health<lastHP
        then
            return true
        end

        return h.Health<h.MaxHealth*.99
    end

    local function Hold()
        if blockHeld then
            return
        end

        blockHeld=true

        pcall(function()
            VIM:SendKeyEvent(
                true,
                BLOCK_KEY,
                false,
                game
            )
        end)
    end

    local function Release()
        if not blockHeld then
            return
        end

        blockHeld=false
        lastRelease=tick()

        pcall(function()
            VIM:SendKeyEvent(
                false,
                BLOCK_KEY,
                false,
                game
            )
        end)
    end

    R.Heartbeat:Connect(function()
        local h=X.Hum(L.Character)

        if h then
            _G._AlastxrLastHP=h.Health
        end

        if not S.AutoBlock then
            if blockHeld then
                Release()
            end

            return
        end

        if tick()-lastRelease<.15 then
            return
        end

        if UnderAttack() then
            Hold()
        end

        if blockHeld
            and tick()-lastRelease>.35
        then
            Release()
        end
    end)
end

--// AUTO COUNTER
do
    local lastCounter={}

    R.Heartbeat:Connect(function()
        if not S.AutoCounter then
            return
        end

        local my=X.Root(L.Character)

        if not my then
            return
        end

        local attacker

        for _,p in ipairs(P:GetPlayers()) do
            if p~=L
                and X.Valid(p)
            then
                local r=X.Root(p.Character)
                local h=X.Hum(p.Character)

                if r
                    and h
                    and (
                        r.Position-my.Position
                    ).Magnitude<=12
                then
                    local animator=
                        h:FindFirstChildOfClass(
                            "Animator"
                        )

                    if animator then
                        for _,track in ipairs(
                            animator:GetPlayingAnimationTracks()
                        ) do
                            local a=track.Animation

                            local n=
                                a
                                and string.lower(a.Name or "")
                                or ""

                            if string.find(
                                n,
                                "punch",
                                1,
                                true
                            )
                                or string.find(
                                    n,
                                    "attack",
                                    1,
                                    true
                                )
                                or string.find(
                                    n,
                                    "m1",
                                    1,
                                    true
                                )
                            then
                                attacker=p
                                break
                            end
                        end
                    end
                end
            end

            if attacker then
                break
            end
        end

        if not attacker then
            return
        end

        if lastCounter[attacker]
            and tick()-lastCounter[attacker]<.55
        then
            return
        end

        lastCounter[attacker]=tick()

        task.spawn(function()
            pcall(function()
                VIM:SendMouseButtonEvent(
                    0,
                    0,
                    2,
                    true,
                    game,
                    0
                )

                task.wait(.12)

                VIM:SendMouseButtonEvent(
                    0,
                    0,
                    2,
                    false,
                    game,
                    0
                )
            end)
        end)
    end)
end

--// DEFENSE ATTORNEY QTE
do
    local keywords={
        "higuruma",
        "trial",
        "qte",
        "judgement",
        "judgment",
        "sentencing",
        "court",
        "finaljudgement",
        "finaljudgment"
    }

    local solved={}

    local function FindQTE(root)
        if not root then
            return
        end

        for _,g in ipairs(root:GetDescendants()) do
            if g:IsA("ScreenGui")
                and g.Enabled
            then
                local n=string.lower(g.Name)

                for _,k in ipairs(keywords) do
                    if string.find(
                        n,
                        k,
                        1,
                        true
                    ) then
                        return g
                    end
                end
            end
        end
    end

    local function FindButton(gui)
        if not gui then
            return
        end

        for _,d in ipairs(gui:GetDescendants()) do
            if d:IsA("GuiButton")
                and d.Visible
            then
                return d
            end
        end
    end

    R.Heartbeat:Connect(function()
        if not S.HigurumaQTE then
            return
        end

        local pg=L:FindFirstChild(
            "PlayerGui"
        )

        local gui=FindQTE(pg)

        if not gui then
            return
        end

        if solved[gui]
            and tick()-solved[gui]<.5
        then
            return
        end

        local b=FindButton(gui)

        if not b then
            return
        end

        solved[gui]=tick()

        pcall(function()
            b:Activate()
        end)

        pcall(function()
            local pos=
                b.AbsolutePosition+
                b.AbsoluteSize/2

            VIM:SendMouseButtonEvent(
                pos.X,
                pos.Y,
                0,
                true,
                game,
                0
            )

            VIM:SendMouseButtonEvent(
                pos.X,
                pos.Y,
                0,
                false,
                game,
                0
            )
        end)
    end)
end

--// PLAYER ESP
do
    local folder=Instance.new(
        "Folder",
        X.G
    )

    folder.Name="AlastxrOnTop_ESP"

    local PE={}

    local function Hide(d)
        if not d then
            return
        end

        if d.Box then
            d.Box.Visible=false
            d.Box.Enabled=false
        end

        if d.Name then
            d.Name.Visible=false
        end

        if d.Health then
            d.Health.Visible=false
        end

        if d.Info then
            d.Info.Enabled=false
        end
    end

    local function Remove(p)
        local d=PE[p]

        if not d then
            return
        end

        for _,v in pairs(d) do
            if typeof(v)=="Instance"
                and v.Parent
            then
                v:Destroy()
            end
        end

        PE[p]=nil
    end

    local function Make(p)
        if p==L then
            return
        end

        Remove(p)

        local d={}
        PE[p]=d

        local f=Instance.new(
            "Folder",
            folder
        )

        f.Name=p.Name
        d.Holder=f

        local box=Instance.new(
            "Highlight",
            f
        )

        box.Adornee=p.Character
        box.FillTransparency=1
        box.OutlineTransparency=0
        box.OutlineColor=S.PlayerBoxColor
        box.DepthMode=
            Enum.HighlightDepthMode.AlwaysOnTop
        box.Enabled=S.PlayerBoxes

        d.Box=box

        local info=Instance.new(
            "BillboardGui",
            f
        )

        info.Adornee=X.Root(
            p.Character
        )

        info.Size=UDim2.fromOffset(
            190,
            45
        )

        info.StudsOffset=Vector3.new(
            0,
            3,
            0
        )

        info.AlwaysOnTop=true
        info.Enabled=false

        d.Info=info

        local text=Instance.new(
            "TextLabel",
            info
        )

        text.Size=UDim2.fromScale(1,1)
        text.BackgroundTransparency=1
        text.TextColor3=Color3.new(1,1,1)
        text.TextStrokeTransparency=0
        text.Font=Enum.Font.GothamBold
        text.TextSize=S.PlayerNameSize

        d.Name=text

        local hp=Instance.new(
            "TextLabel",
            f
        )

        hp.Visible=false
        d.Health=hp
    end

    local function Update(p,d)
        if not p.Character then
            Hide(d)
            return
        end

        local h=X.Hum(p.Character)
        local root=X.Root(p.Character)

        if not h
            or not root
            or h.Health<=0
        then
            Hide(d)
            return
        end

        local cam=W.CurrentCamera

        if not cam then
            Hide(d)
            return
        end

        d.Box.Adornee=p.Character
        d.Box.Enabled=S.PlayerBoxes
        d.Box.OutlineColor=S.PlayerBoxColor

        d.Info.Adornee=root
        d.Info.Enabled=
            S.PlayerNames
            or S.PlayerHealth

        local lines={}

        if S.PlayerNames then
            lines[#lines+1]=
                p.DisplayName..
                (
                    p.DisplayName~=p.Name
                    and " ["..p.Name.."]"
                    or ""
                )
        end

        if S.PlayerHealth then
            lines[#lines+1]=
                math.floor(
                    math.max(
                        0,
                        h.Health
                    )
                )..
                "/"..
                math.floor(
                    h.MaxHealth
                )
        end

        d.Name.Text=table.concat(
            lines,
            "\n"
        )

        d.Name.TextSize=S.PlayerNameSize
        d.Info.Enabled=#lines>0
    end

    local function Hook(p)
        if p==L then
            return
        end

        Make(p)

        p.CharacterAdded:Connect(function()
            task.wait(.15)

            if p.Parent then
                Make(p)
            end
        end)
    end

    for _,p in ipairs(P:GetPlayers()) do
        Hook(p)
    end

    P.PlayerAdded:Connect(Hook)
    P.PlayerRemoving:Connect(Remove)

    R.RenderStepped:Connect(function()
        local enabled=
            S.PlayerBoxes
            or S.PlayerNames
            or S.PlayerHealth
            or S.PlayerTracers

        if not enabled then
            for _,d in pairs(PE) do
                Hide(d)
            end

            return
        end

        for p,d in pairs(PE) do
            if p.Parent then
                pcall(
                    Update,
                    p,
                    d
                )
            else
                Remove(p)
            end
        end
    end)
end

--// ITEM ESP
do
    local folder=X.G:FindFirstChild(
        "AlastxrOnTop_ESP"
    )

    local itemFolder=Instance.new(
        "Folder",
        folder
    )

    itemFolder.Name="ItemESP"

    local IE={}

    local Allowed={
        ["Bowling Ball"]=true,
        ["Naginata"]=true,
        ["Banana Peel"]=true,
        ["TNT"]=true,
        ["Tinted Glasses"]=true,
        ["Transfigured Human"]=true,
        ["Sniper"]=true,
        ["Hazenoki's Eye"]=true,
        ["Voice Recorder"]=true,
        ["Transfigured Flesh"]=true,
        ["Playful Cloud"]=true,
        ["Gun"]=true,
        ["Jet Black"]=true,
        ["Coin"]=true,
        ["Soda"]=true
    }

    local function Enabled()
        return S.ItemBoxes
            or S.ItemNames
            or S.ItemTracers
    end

    local function Resolve(o)
        if not o
            or X.IsPlayerPart(o)
        then
            return
        end

        local x=o

        while x and x~=W do
            if (
                (x:IsA("Model") or x:IsA("Tool"))
                and Allowed[x.Name]
                and X.ItemRoot(x)
                and not X.IsPlayerPart(x)
            ) then
                return x
            end

            x=x.Parent
        end

        if o:IsA("BasePart")
            and Allowed[o.Name]
        then
            return o
        end
    end

    local function Hide(d)
        if not d then
            return
        end

        if d.Box then
            d.Box.Enabled=false
        end

        if d.Info then
            d.Info.Enabled=false
        end
    end

    local function Remove(o)
        local d=IE[o]

        if not d then
            return
        end

        for _,v in pairs(d) do
            if typeof(v)=="Instance"
                and v.Parent
            then
                v:Destroy()
            end
        end

        IE[o]=nil
    end

    local function Make(o)
        o=Resolve(o)

        if not o
            or IE[o]
        then
            return
        end

        local root=X.ItemRoot(o)

        if not root then
            return
        end

        local d={}
        IE[o]=d

        local box=Instance.new(
            "Highlight",
            itemFolder
        )

        box.Adornee=o
        box.FillTransparency=1
        box.OutlineTransparency=0
        box.OutlineColor=S.ItemBoxColor
        box.DepthMode=
            Enum.HighlightDepthMode.AlwaysOnTop
        box.Enabled=S.ItemBoxes

        d.Box=box

        local info=Instance.new(
            "BillboardGui",
            itemFolder
        )

        info.Adornee=root
        info.Size=UDim2.fromOffset(
            180,
            30
        )

        info.StudsOffset=Vector3.new(
            0,
            2.5,
            0
        )

        info.AlwaysOnTop=true
        info.Enabled=S.ItemNames

        local text=Instance.new(
            "TextLabel",
            info
        )

        text.Size=UDim2.fromScale(1,1)
        text.BackgroundTransparency=1
        text.Text=o.Name
        text.TextColor3=Color3.new(1,1,1)
        text.TextStrokeTransparency=0
        text.TextSize=S.ItemNameSize
        text.Font=Enum.Font.GothamBold

        d.Info=info
    end

    local function Scan()
        if not Enabled() then
            return
        end

        local seen={}

        for _,o in ipairs(
            W:GetDescendants()
        ) do
            local item=Resolve(o)

            if item then
                seen[item]=true

                if not IE[item] then
                    Make(item)
                end
            end
        end

        for o in pairs(IE) do
            if not seen[o]
                or not o.Parent
            then
                Remove(o)
            end
        end
    end

    local scanNeeded=true
    local scanRunning=false

    X.RefreshItemESP=function()
        if not Enabled() then
            for _,d in pairs(IE) do
                Hide(d)
            end

            scanNeeded=false
            return
        end

        scanNeeded=true
    end

    W.DescendantAdded:Connect(function(o)
        if not Enabled() then
            return
        end

        task.defer(function()
            if not o.Parent
                or not Enabled()
            then
                return
            end

            local item=Resolve(o)

            if item
                and not IE[item]
            then
                Make(item)
            end
        end)
    end)

    W.DescendantRemoving:Connect(function(o)
        if IE[o] then
            Remove(o)
        end
    end)

    R.RenderStepped:Connect(function()
        if not Enabled() then
            return
        end

        if scanNeeded
            and not scanRunning
        then
            scanRunning=true
            scanNeeded=false

            task.spawn(function()
                Scan()
                scanRunning=false
            end)
        end

        for o,d in pairs(IE) do
            if not o.Parent then
                Remove(o)
            elseif Enabled() then
                d.Box.Enabled=S.ItemBoxes
                d.Box.OutlineColor=S.ItemBoxColor
                d.Info.Enabled=S.ItemNames

                local root=X.ItemRoot(o)

                if root then
                    d.Info.Adornee=root
                end

                local label=
                    d.Info:FindFirstChildOfClass(
                        "TextLabel"
                    )

                if label then
                    label.TextSize=S.ItemNameSize
                    label.Text=o.Name
                end
            end
        end
    end)

    task.defer(function()
        if Enabled() then
            scanNeeded=true
        end
    end)
end

--// INPUT / KEYBINDS
do
    U.InputBegan:Connect(function(input,processed)
        if input.UserInputType~=
            Enum.UserInputType.Keyboard
        then
            return
        end

        local key=input.KeyCode

        --// Keybind capture happens before processed input.
        if X.LockIsListening
            and X.LockIsListening()
        then
            if key~=Enum.KeyCode.Unknown then
                X.SetLockKey(key)
            end

            return
        end

        if X.FlightIsListening
            and X.FlightIsListening()
        then
            if key~=Enum.KeyCode.Unknown then
                X.SetFlightKey(key)
            end

            return
        end

        if X.BlackIsListening
            and X.BlackIsListening()
        then
            if key~=Enum.KeyCode.Unknown then
                X.SetBlackKey(key)
            end

            return
        end

        if X.KillIsListening
            and X.KillIsListening()
        then
            if key~=Enum.KeyCode.Unknown then
                X.SetKillKey(key)
            end

            return
        end

        if processed then
            return
        end

        if key==S.FlyKey
            and S.FlyMaster
        then
            S.Fly=not S.Fly

            if X.RefreshFlight then
                X.RefreshFlight()
            end
        end

        if key==S.LockOnKey
            and S.LockOnMaster
        then
            if S.LockOnEnabled then
                S.LockOnEnabled=false
                X.LockTarget=nil
            else
                local target=X.Closest()

                if target
                    and X.Valid(target)
                then
                    X.LockTarget=target
                    S.LockOnEnabled=true
                end
            end

            if X.RefreshLock then
                X.RefreshLock()
            end
        end

        if key==S.KillKey
            and S.KillMaster
        then
            if S.KillActive then
                S.KillActive=false
                X.KillTarget=nil
            else
                local target=X.LastTarget

                if target
                    and X.Valid(target)
                then
                    X.KillTarget=target
                    S.KillActive=true
                else
                    X.KillTarget=nil
                    S.KillActive=false
                end
            end

            if X.RefreshKill then
                X.RefreshKill()
            end
        end

        if key==S.AutoBlackFlashKey
            and S.AutoBlackFlash
        then
            local target=X.LastTarget

            if not target
                or not X.Valid(target)
            then
                target=X.Closest()
            end

            if target
                and X.Valid(target)
                and X.StartAutoBlackFlash
            then
                X.StartAutoBlackFlash(target)
            end
        end
    end)
end

--// PLAYER CLEANUP
do
    P.PlayerRemoving:Connect(function(p)
        if p==X.LockTarget then
            X.LockTarget=nil
            S.LockOnEnabled=false

            if X.RefreshLock then
                X.RefreshLock()
            end
        end

        if p==X.KillTarget then
            X.KillTarget=nil
            S.KillActive=false

            if X.RefreshKill then
                X.RefreshKill()
            end
        end

        if p==X.LastTarget then
            X.LastTarget=nil
        end

        if p==X.AutoBlackFlashTarget
            and X.StopAutoBlackFlash
        then
            X.StopAutoBlackFlash()
        end
    end)
end

