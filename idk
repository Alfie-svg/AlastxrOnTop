    local bar=Instance.new("Frame",holder)
    bar.Position=UDim2.fromOffset(10,28)
    bar.Size=UDim2.new(1,-20,0,8)
    bar.BackgroundColor3=X.CT().Stroke
    bar.BorderSizePixel=0

    local bc=Instance.new("UICorner",bar)
    bc.CornerRadius=UDim.new(1,0)

    local fill=Instance.new("Frame",bar)
    fill.Size=UDim2.fromScale(0,1)
    fill.BorderSizePixel=0
    fill.BackgroundColor3=X.CT().Accent

    local fc=Instance.new("UICorner",fill)
    fc.CornerRadius=UDim.new(1,0)

    local knob=Instance.new("Frame",bar)
    knob.AnchorPoint=Vector2.new(.5,.5)
    knob.Size=UDim2.fromOffset(14,14)
    knob.BorderSizePixel=0
    knob.BackgroundColor3=Color3.new(1,1,1)

    local kc=Instance.new("UICorner",knob)
    kc.CornerRadius=UDim.new(1,0)

    local dragging=false

    local function refresh(v)
        v=math.clamp(math.round(v),min,max)
        local alpha=(v-min)/(max-min)

        val.Text=tostring(v)
        fill.Size=UDim2.fromScale(alpha,1)
        knob.Position=UDim2.new(alpha,0,.5,0)
    end

    local function setFromX(x)
        local alpha=math.clamp(
            (x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,
            0,
            1
        )

        local v=math.round(min+(max-min)*alpha)
        set(v)
        refresh(v)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=true
            setFromX(input.Position.X)
        end
    end)

    U.InputChanged:Connect(function(input)
        if dragging
            and input.UserInputType==Enum.UserInputType.MouseMovement
        then
            setFromX(input.Position.X)
        end
    end)

    U.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=false
        end
    end)

    refresh(value)

    return holder,refresh
end

