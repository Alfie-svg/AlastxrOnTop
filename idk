function X.tw(o,props)
    if o then
        T:Create(o,A,props):Play()
    end
end

function X.Reg(o,key)
    o:SetAttribute("AlastxrTheme",key)
end

function X.Theme()
    local t=X.CT()

    if X.M then
        X.M.BackgroundColor3=t.Main
    end

    if X.Body then
        X.Body.BackgroundColor3=t.Content
    end

    if X.Content then
        X.Content.BackgroundColor3=t.Content
    end

    if X.G then
        for _,o in ipairs(X.G:GetDescendants()) do
            if o:IsA("UIStroke") then
                o.Color=t.Stroke
            end

            local key=o:GetAttribute("AlastxrTheme")

            if key=="Top" and o:IsA("GuiObject") then
                o.BackgroundColor3=t.Top
            elseif key=="Side" and o:IsA("GuiObject") then
                o.BackgroundColor3=t.Side
            elseif key=="Content" and o:IsA("GuiObject") then
                o.BackgroundColor3=t.Content
            elseif key=="Panel" and o:IsA("GuiObject") then
                o.BackgroundColor3=t.Panel
            elseif key=="Button" and o:IsA("GuiObject") then
                o.BackgroundColor3=t.Button
            elseif key=="Hover" and o:IsA("GuiObject") then
                o.BackgroundColor3=t.Hover
            end

            if o:IsA("TextLabel")
                or o:IsA("TextButton")
                or o:IsA("TextBox")
            then
                if not o:GetAttribute("AlastxrKeepTextColor") then
                    o.TextColor3=t.Text
                end
            end
        end
    end
end

