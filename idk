        p.CharacterRemoving:Connect(function(c)
            CharacterSet[c]=nil
        end)
    end

    function X.IsPlayerPart(o)
        if not o then
            return true
        end

        for c in pairs(CharacterSet) do
            if c
                and c.Parent
                and o:IsDescendantOf(c)
            then
                return true
            end
        end

        return false
    end

    for _,p in ipairs(P:GetPlayers()) do
        AddCharacter(p)
    end

    P.PlayerAdded:Connect(AddCharacter)

    P.PlayerRemoving:Connect(function(p)
        if p.Character then
            CharacterSet[p.Character]=nil
        end
    end)
end

--// ITEM HELPERS / BRING
do
    local Allowed={
        ["Bowling Ball"]=true,
        ["Naginata"]=true,
        ["Banana Peel"]=true,
        ["TNT"]=true,
        ["Tinted Glasses"]=true,
        ["Transfigured Human"]=true,
        ["Sniper"]=true,
        ["Hazenoki's Eye"]=true,
        ["Voice Recorder"]=true,
        ["Transfigured Flesh"]=true,
        ["Playful Cloud"]=true,
        ["Gun"]=true,
        ["Jet Black"]=true,
        ["Coin"]=true,
        ["Soda"]=true
    }

    local function ItemRoot(o)
        if not o then
            return
        end

        if o:IsA("BasePart") then
            return o
        end

        if o:IsA("Tool") then
            return o:FindFirstChild("Handle")
                or o:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )
        end

        if o:IsA("Model") then
            return o.PrimaryPart
                or o:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )
        end
    end

    X.ItemRoot=ItemRoot

    local function ItemContainer(o)
        if not o
            or X.IsPlayerPart(o)
        then
            return
        end

        if (
            (o:IsA("Model") or o:IsA("Tool"))
            and Allowed[o.Name]
            and ItemRoot(o)
        ) then
            return o
        end

        local x=o

        while x and x~=W do
            if (
                (x:IsA("Model") or x:IsA("Tool"))
                and Allowed[x.Name]
                and ItemRoot(x)
                and not X.IsPlayerPart(x)
            ) then
                return x
            end

            x=x.Parent
        end

        if o:IsA("BasePart")
            and Allowed[o.Name]
        then
            return o
        end
    end

    X.ItemContainer=ItemContainer

    local function GetItems(name)
        local found={}
        local seen={}

        for _,o in ipairs(W:GetDescendants()) do
            local x=ItemContainer(o)

            if x
                and (
                    not name
                    or x.Name==name
                )
                and not seen[x]
            then
                seen[x]=true
                found[#found+1]=x
            end
        end

        return found
    end

    X.GetItems=GetItems

    local function MoveItem(o,pos)
        o=ItemContainer(o) or o

        if not o
            or not o.Parent
            or X.IsPlayerPart(o)
        then
            return false
        end

        local r=ItemRoot(o)

        if not r then
            return false
        end

        return pcall(function()
            if o:IsA("Model") then
                o:PivotTo(CFrame.new(pos))
            else
                r.CFrame=CFrame.new(pos)
            end
        end)
    end

    X.MoveItem=MoveItem

    function X.BringOne(name)
        local r=X.Root(L.Character)

        if not r then
            return
        end

        local best,bd=nil,math.huge

        for _,o in ipairs(GetItems(name)) do
            local x=ItemRoot(o)

            if x then
                local d=(
                    x.Position-r.Position
                ).Magnitude

                if d<bd then
                    bd=d
                    best=o
                end
            end
        end

        if best then
            MoveItem(
                best,
                r.Position
                +r.CFrame.LookVector*3
                +Vector3.new(0,1,0)
            )
        end
    end

    function X.BringAll()
        local r=X.Root(L.Character)

        if not r then
            return
        end

        for i,o in ipairs(GetItems()) do
            local n=i-1

            local angle=
                (n%12)/12*
                math.pi*2

            local radius=
                3+
                math.floor(n/12)*2

            MoveItem(
                o,
                r.Position+
                Vector3.new(
                    math.cos(angle)*radius,
                    1+math.floor(n/36)*2,
                    math.sin(angle)*radius
                )
            )
        end
    end
end

--// TARGET TRACKING
do
    local touchConnections={}

    local function ClearTouch()
        for _,c in ipairs(touchConnections) do
            pcall(function()
                c:Disconnect()
            end)
        end

        table.clear(touchConnections)
    end

    local function Track(c)
        if not c then
            return
        end

        ClearTouch()

        local function add(x)
            if x:IsA("BasePart") then
                table.insert(
                    touchConnections,
                    x.Touched:Connect(function(hit)
                        local p=X.FindPlayer(hit)

                        if p
                            and X.Valid(p)
                        then
                            X.LastTarget=p
                        end
                    end)
                )
            end
        end

        for _,x in ipairs(c:GetDescendants()) do
            add(x)
        end

        table.insert(
            touchConnections,
            c.DescendantAdded:Connect(add)
        )
    end

    if L.Character then
        task.defer(function()
            Track(L.Character)
        end)
    end

    L.CharacterAdded:Connect(function(c)
        X.LastTarget=nil

        task.wait(.1)

        if c.Parent then
            Track(c)
        end
    end)

    function X.Closest()
        local cam=W.CurrentCamera

        if not cam then
            return
        end

        local center=cam.ViewportSize/2
        local best,bd=nil,math.huge

        for _,p in ipairs(P:GetPlayers()) do
            if X.Valid(p) then
                local root=X.Root(p.Character)

                local q,on=cam:WorldToViewportPoint(
                    root.Position
                )

                if on then
                    local d=(
                        Vector2.new(q.X,q.Y)-center
                    ).Magnitude

                    if d<bd then
                        bd=d
                        best=p
                    end
                end
            end
        end

        return best
    end
end

--// AUTO BLACK FLASH
do
    local lastPulse=0
    local debounce=.9

    local function Stop()
        X.AutoBlackFlashRunning=false
        X.AutoBlackFlashTarget=nil

        if X.AutoBlackFlashFollow then
            pcall(function()
                X.AutoBlackFlashFollow:Disconnect()
            end)

            X.AutoBlackFlashFollow=nil
        end
    end

    X.StopAutoBlackFlash=Stop

    local function Behind(target)
        if not X.Valid(target) then
            return
        end

        local my,tr=
            X.Root(L.Character),
            X.Root(target.Character)

        if not my or not tr then
            return
        end

        local pos=
            tr.Position-
            tr.CFrame.LookVector*4

        pos=Vector3.new(
            pos.X,
            tr.Position.Y,
            pos.Z
        )

        return CFrame.lookAt(
            pos,
            tr.Position
        )
    end

    local function MouseClick()
        local ok=false

        pcall(function()
            if mouse1click then
                mouse1click()
                ok=true
            end
        end)

        if ok then
            return true
        end

        pcall(function()
            VIM:SendMouseButtonEvent(
                0,0,0,true,game,0
            )

            VIM:SendMouseButtonEvent(
                0,0,0,false,game,0
            )

            ok=true
        end)

        return ok
    end

    local function BlackInput()
        pcall(function()
            VIM:SendMouseButtonEvent(
                0,0,0,true,game,0
            )

            task.wait(.02)

            VIM:SendMouseButtonEvent(
                0,0,0,false,game,0
            )
        end)
    end

    local function HasWindow(c)
        if not c then
            return false
        end

        if c:GetAttribute("BlackFlashWindow")==true then
            return true
        end

        for _,d in ipairs(c:GetDescendants()) do
            if d:IsA("Animator") then
                for _,track in ipairs(
                    d:GetPlayingAnimationTracks()
                ) do
                    local a=track.Animation

                    if a
                        and string.find(
                            string.lower(a.Name or ""),
                            "blackflash",
                            1,
                            true
                        )
                    then
                        return true
                    end
                end
            end
        end

        return false
    end

    function X.StartAutoBlackFlash(target)
        if not S.AutoBlackFlash
            or not X.Valid(target)
        then
            return
        end

        Stop()

        X.AutoBlackFlashRunning=true
        X.AutoBlackFlashTarget=target

        local root=X.Root(L.Character)

        if not root then
            Stop()
            return
        end

        task.spawn(function()
            local elapsed=0

            while X.AutoBlackFlashRunning
                and X.AutoBlackFlashTarget==target
                and X.Valid(target)
                and root.Parent
                and elapsed<.08
            do
                task.wait()

                local cf=Behind(target)

                if not cf then
                    Stop()
                    return
                end

                elapsed+=.016

                local a=math.clamp(
                    elapsed/.08,
                    0,
                    1
                )

                a=1-(1-a)^3

                root.CFrame=root.CFrame:Lerp(
                    cf,
                    a
                )
            end

            if X.AutoBlackFlashRunning
                and X.AutoBlackFlashTarget==target
                and X.Valid(target)
            then
                local cf=Behind(target)

                if cf and root.Parent then
                    root.CFrame=cf
                end
            end
        end)

        X.AutoBlackFlashFollow=
            R.RenderStepped:Connect(function()
                if not X.AutoBlackFlashRunning then
                    return
                end

                if not X.Valid(
                    X.AutoBlackFlashTarget
                ) then
                    Stop()
                    return
                end

                local r=X.Root(L.Character)
                local cf=Behind(
                    X.AutoBlackFlashTarget
                )

                if not r or not cf then
                    Stop()
                    return
                end

                if (
                    r.Position-cf.Position
                ).Magnitude>1 then
                    r.CFrame=r.CFrame:Lerp(
                        cf,
                        .3
                    )
                end
            end)

        task.spawn(function()
            task.wait(.1)

            if not X.AutoBlackFlashRunning
                or X.AutoBlackFlashTarget~=target
                or not S.AutoBlackFlash
                or not X.Valid(target)
            then
                return
            end

            local r=X.Root(L.Character)
            local cf=Behind(target)

            if r and cf then
                r.CFrame=cf
            end

            task.wait()

            if not X.AutoBlackFlashRunning
                or X.AutoBlackFlashTarget~=target
                or not S.AutoBlackFlash
                or not X.Valid(target)
            then
                return
            end

            MouseClick()

            task.wait(.35)

            if X.AutoBlackFlashTarget==target then
                Stop()
            end
        end)
    end

    R.Heartbeat:Connect(function()
        if not S.AutoBlackFlash then
            return
        end

        if tick()-lastPulse<debounce then
            return
        end

        local c=L.Character

        if not c then
            return
        end

        if HasWindow(c) then
            lastPulse=tick()

            if not X.AutoBlackFlashRunning then
                BlackInput()
            end
        end

        if _G.AlastxrBlackFlash then
            _G.AlastxrBlackFlash=nil
            lastPulse=tick()
            BlackInput()
        end
    end)
end

--// ANTI-STUN
do
    local Running=false

    local function RestoreMovement()
        local c=L.Character
        local h=X.Hum(c)

        if not c or not h then
            return
        end

        if h.Health<=0 then
            return
        end

        pcall(function()
            h.PlatformStand=false
            h.AutoRotate=true
        end)

        local r=X.Root(c)

        if r then
            pcall(function()
                r.AssemblyLinearVelocity=
                    Vector3.new(
                        r.AssemblyLinearVelocity.X,
                        0,
                        r.AssemblyLinearVelocity.Z
                    )

                r.AssemblyAngularVelocity=
                    Vector3.zero
            end)
        end
    end

    local function RemoveCommonStunObjects()
        local c=L.Character

        if not c then
            return
        end

        for _,o in ipairs(c:GetChildren()) do
            local n=string.lower(o.Name)

            if string.find(n,"stun",1,true)
                or string.find(n,"ragdoll",1,true)
                or string.find(n,"freeze",1,true)
                or string.find(n,"root",1,true)
            then
                if o:IsA("BoolValue")
                    or o:IsA("NumberValue")
                    or o:IsA("IntValue")
                then
                    pcall(function()
                        if o:IsA("BoolValue") then
                            o.Value=false
                        else
                            o.Value=0
                        end
                    end)
                end
            end
        end
    end

    R.Heartbeat:Connect(function()
        if not S.AntiStun then
            if Running then
                Running=false
            end

            return
        end

        Running=true
        RestoreMovement()
        RemoveCommonStunObjects()
    end)

    local function HookCharacter(c)
        if not c then
            return
        end

        local names={
            "Stunned",
            "Stun",
            "HitStun",
            "StunTime",
            "Ragdoll",
            "Ragdolled",
            "Frozen",
            "Freeze",
            "Rooted",
            "Root"
        }

        for _,name in ipairs(names) do
            c:GetAttributeChangedSignal(name):Connect(function()
                if S.AntiStun then
                    task.defer(function()
                        RestoreMovement()
                    end)
                end
            end)
        end
    end

    if L.Character then
        HookCharacter(L.Character)
    end

    L.CharacterAdded:Connect(function(c)
        task.wait(.15)
        HookCharacter(c)
    end)
end

--// FLIGHT
do
    local previous=false

    local function FlightState(active)
        local h=X.Hum(L.Character)
        local r=X.Root(L.Character)

        if not h then
            return
        end

        if active then
            h.PlatformStand=true
            h.AutoRotate=false
        else
            h.PlatformStand=false
            h.AutoRotate=true

            if r then
                r.AssemblyLinearVelocity=Vector3.zero
                r.AssemblyAngularVelocity=Vector3.zero
            end
        end
    end

    local function Ready()
        if not (
            S.FlyMaster
            and S.Fly
        ) then
            if previous then
                FlightState(false)
                previous=false
            end

            return
        end

        local c=L.Character
        local h=X.Hum(c)
        local r=X.Root(c)
        local cam=W.CurrentCamera

        if not c
            or not h
            or not r
            or not cam
            or h.Health<=0
        then
            return
        end

        if not previous then
            FlightState(true)
            previous=true
        end

        return c,h,r,cam
    end

    R:BindToRenderStep(
        "AlastxrFlight",
        Enum.RenderPriority.Camera.Value+50,
        function()
            local c,h,r,cam=Ready()

            if not c then
                return
            end

            local look=cam.CFrame.LookVector

            if not (
                S.LockOnMaster
                and S.LockOnEnabled
                and S.LockOnMode=="Character"
                and X.Valid(X.LockTarget)
            ) then
                local flat=Vector3.new(
                    look.X,
                    0,
                    look.Z
                )

                if flat.Magnitude>.001 then
                    r.CFrame=CFrame.lookAt(
                        r.Position,
                        r.Position+flat.Unit
                    )
                end
            end

            r.AssemblyAngularVelocity=Vector3.zero
        end
    )

    R:BindToRenderStep(
        "AlastxrFlightVelocity",
        Enum.RenderPriority.Last.Value,
        function()
            local c,h,r,cam=Ready()

            if not c then
                return
            end

            local look=cam.CFrame.LookVector
            local right=cam.CFrame.RightVector
            local direction=Vector3.zero

            if U:IsKeyDown(Enum.KeyCode.W) then
                direction+=look
            end

            if U:IsKeyDown(Enum.KeyCode.S) then
                direction-=look
            end

            if U:IsKeyDown(Enum.KeyCode.D) then
                direction+=right
            end

            if U:IsKeyDown(Enum.KeyCode.A) then
                direction-=right
            end

            if direction.Magnitude>0 then
                r.AssemblyLinearVelocity=
                    direction.Unit*S.FlySpeed
            else
                r.AssemblyLinearVelocity=
                    Vector3.zero
            end

            r.AssemblyAngularVelocity=Vector3.zero
        end
    )

    L.CharacterAdded:Connect(function()
        previous=false

        if X.StopAutoBlackFlash then
            X.StopAutoBlackFlash()
        end
    end)
end

--// LOCK ON
do
    R:BindToRenderStep(
        "AlastxrStrongLock",
